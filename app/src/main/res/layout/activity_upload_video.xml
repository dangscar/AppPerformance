<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.UploadVideoActivity">

    <LinearLayout
        android:id="@+id/ll_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#47000000"
        android:gravity="center"
        android:visibility="gone">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loadingView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            app:lottie_rawRes="@raw/loading"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:visibility="visible"/>
    </LinearLayout>
    <!-- Mô tả -->
    <EditText
        android:id="@+id/edtDescription"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="Thêm mô tả..."
        android:textSize="16sp"
        android:background="@android:color/transparent"
        android:padding="16dp"
        android:gravity="top"
        android:fontFamily="@font/tiktoksans_regular"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardCover"
        app:layout_constraintBottom_toBottomOf="@id/cardCover"/>

    <!-- Ảnh bìa -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCover"
        android:layout_width="90dp"
        android:layout_height="130dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/fl_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null">

            <ImageView
                android:id="@+id/iv_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@color/black"
                android:scaleType="centerCrop"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem"
                android:textColor="#fff"
                android:layout_margin="8dp"
                android:layout_gravity="top|start"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sửa ảnh bìa"
                android:textColor="#fff"
                android:textSize="12sp"
                android:layout_gravity="bottom|center"
                android:layout_marginBottom="8dp"/>
        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- hashtag -->
    <Button
        android:id="@+id/btnHashtag"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="# Hashtag"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:backgroundTint="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/edtDescription"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"/>

    <!-- mention -->
    <Button
        android:id="@+id/btnMention"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="\@ Nhắc đến"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:backgroundTint="#E0E0E0"
        app:layout_constraintStart_toEndOf="@id/btnHashtag"
        app:layout_constraintTop_toTopOf="@id/btnHashtag"
        android:layout_marginStart="8dp"/>

    <!-- divider -->
    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        app:layout_constraintTop_toBottomOf="@id/btnHashtag"
        android:layout_marginTop="16dp"/>

    <!-- Vị trí -->
    <LinearLayout
        android:id="@+id/layoutLocation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/viewDivider">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_location"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Vị trí"
            android:textSize="16sp"
            android:fontFamily="@font/tiktoksans_regular"
            android:textColor="@color/black"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

    <!-- Thêm liên kết -->
    <LinearLayout
        android:id="@+id/layoutLink"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutLocation">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add"/>

        <TextView
            android:text="Thêm liên kết"
            android:textSize="16sp"
            android:fontFamily="@font/tiktoksans_regular"
            android:textColor="@color/black"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_forward"/>
    </LinearLayout>

    <!-- Quyền xem -->
    <LinearLayout
        android:id="@+id/layoutPrivacy"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutLink">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_explore"
            app:tint="@color/black" />

        <TextView
            android:text="Ai cũng có thể xem bài đăng này"
            android:textSize="16sp"
            android:fontFamily="@font/tiktoksans_regular"
            android:textColor="@color/black"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_forward"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMoreOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/layoutPrivacy">

        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/more"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tùy chọn khác"
            android:textSize="16sp"
            android:fontFamily="@font/tiktoksans_semibold"
            android:textColor="@color/black"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/iv_more"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý chất lượng tải lên"
            android:textSize="13sp"
            android:fontFamily="@font/tiktoksans_regular"
            android:textColor="#888888"
            app:layout_constraintTop_toBottomOf="@id/tv_option"
            app:layout_constraintStart_toStartOf="@id/tv_option"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layoutShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/layoutMoreOptions">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chia sẻ với"
            android:textSize="16sp"
            android:fontFamily="@font/tiktoksans_regular"
            android:textColor="@color/black"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/x"
                android:layout_marginEnd="10dp"/>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/facebook"
                android:layout_marginEnd="10dp"/>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/pin"
                android:layout_marginEnd="10dp"/>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/in"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnDraft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Nháp"
            android:textSize="16sp"
            android:fontFamily="@font/tiktoksans_semibold"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_gray"
            android:elevation="0dp"
            android:shadowColor="@color/white"/>

        <Button
            android:id="@+id/btnPost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Đăng"
            android:textSize="16sp"
            android:fontFamily="@font/tiktoksans_semibold"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_red"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>