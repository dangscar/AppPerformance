<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".Activity.EditVideoActivity">

    <!-- Top Bar -->
    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Hủy"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Lưu"
        android:textColor="#FE2C55"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Video Preview -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="60dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomControl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCancel"
        app:use_controller="false" />

    <!-- Play/Pause Overlay Icon -->
    <ImageView
        android:id="@+id/ivPlayPause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_play"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/playerView"
        app:layout_constraintEnd_toEndOf="@+id/playerView"
        app:layout_constraintStart_toStartOf="@+id/playerView"
        app:layout_constraintTop_toTopOf="@+id/playerView"
        app:tint="@android:color/white" />

    <!-- Bottom Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Timeline Trimmer Container -->
        <FrameLayout
            android:id="@+id/trimmerContainer"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Thumbnail video -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvThumbnails"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Overlay trái -->
            <View
                android:id="@+id/overlayLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#99000000"/>

            <!-- Overlay phải -->
            <View
                android:id="@+id/overlayRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="#99000000" />

            <!-- Vùng trim -->

            <!-- Playhead -->
            <FrameLayout
                android:id="@+id/trimFrame"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_trim_border">

                <!-- Handle trái -->
                <View
                    android:id="@+id/leftHandle"
                    android:layout_width="12dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="#FE2C55" />

                <!-- Handle phải -->
                <View
                    android:id="@+id/rightHandle"
                    android:layout_width="12dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="#FE2C55" />

            </FrameLayout>

            <View
                android:id="@+id/playHead"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:clickable="false"
                android:focusable="false"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tvDurationSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Đã chọn 21,3 giây"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/trimmerContainer" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/tvDurationSelected"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvDurationSelected">

            <ImageButton
                android:id="@+id/btnSpeed"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/time"
                app:tint="@android:color/white"
                android:layout_marginEnd="12dp"/>

            <ImageButton
                android:id="@+id/btnRotate"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="@android:color/white" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>